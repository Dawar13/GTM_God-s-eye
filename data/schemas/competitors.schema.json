{
  "$id": "capital-atlas/competitors.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "version": {
      "type": "number",
      "const": 2
    },
    "generated_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
      "description": "When the pipeline wrote the file"
    },
    "records": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^co_[a-z0-9][a-z0-9_-]*$",
            "description": "Stable id, `co_<slug>`"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "website": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^https?:\\/\\/\\S+$",
                "description": "Absolute http(s) URL"
              },
              {
                "type": "null"
              }
            ],
            "description": "Own site; companies are de-duplicated by its domain"
          },
          "hq_country": {
            "description": "ISO 3166-1 alpha-2",
            "type": [
              "string",
              "null"
            ]
          },
          "founded_year": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 1900,
                "maximum": 2100
              },
              {
                "type": "null"
              }
            ]
          },
          "sector": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "ai_infra",
                  "ai_apps_agents",
                  "industrial_manufacturing",
                  "robotics_physical_ai",
                  "defense_dual_use",
                  "hardware_deeptech",
                  "space",
                  "climate_energy",
                  "mobility_ev",
                  "supply_chain_logistics",
                  "enterprise_saas",
                  "dev_tools",
                  "fintech",
                  "health_bio",
                  "consumer",
                  "crypto_web3"
                ]
              },
              {
                "type": "null"
              }
            ]
          },
          "sector_classified_by": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "source",
                  "model"
                ]
              },
              {
                "type": "null"
              }
            ],
            "description": "source: the company's own description says so; model: classified by the researcher"
          },
          "layer": {
            "type": "string",
            "enum": [
              "design_intent",
              "process_planning",
              "plant_ops",
              "quality_vision",
              "autonomy_tooling",
              "robotics",
              "full_stack_factory"
            ],
            "description": "Position on the layer map (PROJECT_CONTEXT §2)"
          },
          "description_short": {
            "description": "One line, paraphrased",
            "type": [
              "string",
              "null"
            ]
          },
          "total_raised_usd": {
            "anyOf": [
              {
                "type": "number",
                "minimum": 0,
                "description": "US dollars (not millions)"
              },
              {
                "type": "null"
              }
            ]
          },
          "sources": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "url": {
                  "type": "string",
                  "pattern": "^(https?:\\/\\/\\S+|user_supplied:[a-z0-9_.-]+)$",
                  "description": "Where the fact came from: an http(s) URL, or `user_supplied:<source_id>` for a user list with no link"
                },
                "title": {
                  "description": "Page or document title, if known",
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "publisher": {
                  "description": "Publisher or site, if known",
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "retrieved_at": {
                  "type": "string",
                  "format": "date",
                  "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$",
                  "description": "Date the source was read"
                },
                "kind": {
                  "type": "string",
                  "enum": [
                    "primary",
                    "secondary",
                    "user_supplied"
                  ],
                  "description": "primary, secondary or user_supplied (PROJECT_CONTEXT §5)"
                }
              },
              "required": [
                "url",
                "title",
                "publisher",
                "retrieved_at",
                "kind"
              ],
              "additionalProperties": false,
              "description": "Provenance for a record or a single fact"
            },
            "description": "At least one source; first is primary"
          },
          "field_sources": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {
              "minItems": 1,
              "type": "array",
              "items": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              }
            },
            "description": "Field name -> indexes into sources"
          },
          "confidence": {
            "type": "string",
            "enum": [
              "high",
              "medium",
              "low"
            ],
            "description": "high: primary source or two independent secondaries agree; medium: one reputable secondary; low: user-supplied list or database page only"
          },
          "is_competitor": {
            "type": "boolean",
            "const": true
          },
          "category": {
            "type": "string",
            "enum": [
              "direct",
              "adjacent",
              "remote"
            ]
          },
          "layer_detail": {
            "description": "Finer layer, e.g. maintenance / condition monitoring",
            "type": [
              "string",
              "null"
            ]
          },
          "size_class": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "under_5m",
                  "from_5m_to_25m",
                  "from_25m_to_100m",
                  "from_100m_to_1b",
                  "over_1b"
                ]
              },
              {
                "type": "null"
              }
            ],
            "description": "By total raised"
          },
          "founders": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "named_customers": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Customers the company names publicly"
          },
          "headcount_est": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "value": {
                    "type": "integer",
                    "exclusiveMinimum": 0,
                    "maximum": 9007199254740991
                  },
                  "source": {
                    "type": "object",
                    "properties": {
                      "url": {
                        "type": "string",
                        "pattern": "^(https?:\\/\\/\\S+|user_supplied:[a-z0-9_.-]+)$",
                        "description": "Where the fact came from: an http(s) URL, or `user_supplied:<source_id>` for a user list with no link"
                      },
                      "title": {
                        "description": "Page or document title, if known",
                        "type": [
                          "string",
                          "null"
                        ]
                      },
                      "publisher": {
                        "description": "Publisher or site, if known",
                        "type": [
                          "string",
                          "null"
                        ]
                      },
                      "retrieved_at": {
                        "type": "string",
                        "format": "date",
                        "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$",
                        "description": "Date the source was read"
                      },
                      "kind": {
                        "type": "string",
                        "enum": [
                          "primary",
                          "secondary",
                          "user_supplied"
                        ],
                        "description": "primary, secondary or user_supplied (PROJECT_CONTEXT §5)"
                      }
                    },
                    "required": [
                      "url",
                      "title",
                      "publisher",
                      "retrieved_at",
                      "kind"
                    ],
                    "additionalProperties": false,
                    "description": "Provenance for a record or a single fact"
                  }
                },
                "required": [
                  "value",
                  "source"
                ],
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ],
            "description": "Approximate headcount, only with a source (e.g. LinkedIn page)"
          },
          "revenue_usd": {
            "anyOf": [
              {
                "type": "number",
                "minimum": 0,
                "description": "US dollars (not millions)"
              },
              {
                "type": "null"
              }
            ],
            "description": "Only when publicly reported; never estimated"
          },
          "revenue_basis": {
            "type": "string",
            "enum": [
              "reported",
              "none"
            ]
          },
          "product_summary": {
            "description": "≤ 50 words",
            "type": [
              "string",
              "null"
            ]
          },
          "pricing": {
            "description": "Public pricing, as stated",
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "id",
          "name",
          "website",
          "hq_country",
          "founded_year",
          "sector",
          "sector_classified_by",
          "layer",
          "description_short",
          "total_raised_usd",
          "sources",
          "field_sources",
          "confidence",
          "is_competitor",
          "category",
          "layer_detail",
          "size_class",
          "founders",
          "named_customers",
          "headcount_est",
          "revenue_usd",
          "revenue_basis",
          "product_summary",
          "pricing"
        ],
        "additionalProperties": false,
        "description": "A company we compete with or benchmark against"
      }
    }
  },
  "required": [
    "version",
    "generated_at",
    "records"
  ],
  "additionalProperties": false
}
