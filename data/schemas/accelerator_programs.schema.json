{
  "$id": "capital-atlas/accelerator_programs.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "version": {
      "type": "number",
      "const": 2
    },
    "generated_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
      "description": "When the pipeline wrote the file"
    },
    "records": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^prog_[a-z0-9][a-z0-9_-]*$",
            "description": "Stable id, `prog_<slug>`"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "rank_in_list": {
            "anyOf": [
              {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              },
              {
                "type": "null"
              }
            ],
            "description": "Position in the source list"
          },
          "investor_id": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^inv_[a-z0-9][a-z0-9_-]*$",
                "description": "Stable id, `inv_<slug>`"
              },
              {
                "type": "null"
              }
            ],
            "description": "The firm that runs it, when its name matches one investor record exactly"
          },
          "terms_as_listed": {
            "type": "string",
            "description": "Terms exactly as the source list states them; unverified"
          },
          "headline_amount": {
            "anyOf": [
              {
                "type": "number",
                "minimum": 0
              },
              {
                "type": "null"
              }
            ],
            "description": "Largest total the listed terms state, in `currency`"
          },
          "currency": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 3,
                "maxLength": 3
              },
              {
                "type": "null"
              }
            ]
          },
          "headline_usd": {
            "anyOf": [
              {
                "type": "number",
                "minimum": 0,
                "description": "US dollars (not millions)"
              },
              {
                "type": "null"
              }
            ],
            "description": "headline_amount in USD at the list year's rate"
          },
          "upfront_amount": {
            "anyOf": [
              {
                "type": "number",
                "minimum": 0
              },
              {
                "type": "null"
              }
            ],
            "description": "First check, in `currency`"
          },
          "upfront_equity_pct": {
            "anyOf": [
              {
                "type": "number",
                "minimum": 0,
                "maximum": 100
              },
              {
                "type": "null"
              }
            ],
            "description": "Equity the listed terms state for the first check"
          },
          "equity_free": {
            "description": "True only when the list says equity-free",
            "type": [
              "boolean",
              "null"
            ]
          },
          "fx": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "rate_to_usd": {
                    "type": "number",
                    "exclusiveMinimum": 0,
                    "description": "USD per unit of the original currency"
                  },
                  "rate_period": {
                    "type": "string",
                    "description": "Year or date the rate is for"
                  },
                  "source_url": {
                    "type": "string",
                    "pattern": "^https?:\\/\\/\\S+$",
                    "description": "Absolute http(s) URL"
                  }
                },
                "required": [
                  "rate_to_usd",
                  "rate_period",
                  "source_url"
                ],
                "additionalProperties": false,
                "description": "FX rate applied (pipeline/atlas/fx.py)"
              },
              {
                "type": "null"
              }
            ]
          },
          "sources": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "url": {
                  "type": "string",
                  "pattern": "^(https?:\\/\\/\\S+|user_supplied:[a-z0-9_.-]+)$",
                  "description": "Where the fact came from: an http(s) URL, or `user_supplied:<source_id>` for a user list with no link"
                },
                "title": {
                  "description": "Page or document title, if known",
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "publisher": {
                  "description": "Publisher or site, if known",
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "retrieved_at": {
                  "type": "string",
                  "format": "date",
                  "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$",
                  "description": "Date the source was read"
                },
                "kind": {
                  "type": "string",
                  "enum": [
                    "primary",
                    "secondary",
                    "user_supplied"
                  ],
                  "description": "primary, secondary or user_supplied (PROJECT_CONTEXT §5)"
                }
              },
              "required": [
                "url",
                "title",
                "publisher",
                "retrieved_at",
                "kind"
              ],
              "additionalProperties": false,
              "description": "Provenance for a record or a single fact"
            },
            "description": "At least one source; first is primary"
          },
          "confidence": {
            "type": "string",
            "enum": [
              "high",
              "medium",
              "low"
            ],
            "description": "high: primary source or two independent secondaries agree; medium: one reputable secondary; low: user-supplied list or database page only"
          }
        },
        "required": [
          "id",
          "name",
          "rank_in_list",
          "investor_id",
          "terms_as_listed",
          "headline_amount",
          "currency",
          "headline_usd",
          "upfront_amount",
          "upfront_equity_pct",
          "equity_free",
          "fx",
          "sources",
          "confidence"
        ],
        "additionalProperties": false,
        "description": "An accelerator or residency programme and its terms as a source lists them"
      }
    }
  },
  "required": [
    "version",
    "generated_at",
    "records"
  ],
  "additionalProperties": false
}
