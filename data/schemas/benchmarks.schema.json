{
  "$id": "capital-atlas/benchmarks.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "version": {
      "type": "number",
      "const": 2
    },
    "generated_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
      "description": "When the pipeline wrote the file"
    },
    "records": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^bm_[a-z0-9][a-z0-9_-]*$",
            "description": "Stable id, `bm_<slug>`"
          },
          "metric": {
            "type": "string",
            "enum": [
              "median_round_size",
              "median_pre_money",
              "median_post_money",
              "median_dilution",
              "safe_cap_median",
              "safe_share_of_rounds",
              "note_share_of_rounds",
              "time_between_rounds",
              "deal_count",
              "capital_invested",
              "fund_count",
              "capital_raised_by_funds",
              "median_fund_size"
            ]
          },
          "stage": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "pre_seed",
                  "seed",
                  "series_a",
                  "series_b",
                  "series_c_plus",
                  "growth",
                  "strategic",
                  "undisclosed"
                ]
              },
              {
                "type": "string",
                "const": "all"
              }
            ],
            "description": "Stage the figure covers"
          },
          "instrument": {
            "description": "e.g. post-money SAFE, priced equity",
            "type": [
              "string",
              "null"
            ]
          },
          "geography": {
            "type": "string",
            "enum": [
              "us",
              "india",
              "europe",
              "global"
            ]
          },
          "period": {
            "type": "string",
            "description": "Period the figure covers, e.g. 2026-Q2 or 2025"
          },
          "value": {
            "type": "number"
          },
          "unit": {
            "type": "string",
            "enum": [
              "usd",
              "fraction",
              "days",
              "months",
              "count"
            ]
          },
          "sample_size": {
            "anyOf": [
              {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              },
              {
                "type": "null"
              }
            ]
          },
          "publisher": {
            "type": "string",
            "description": "e.g. Carta, PitchBook-NVCA"
          },
          "notes": {
            "type": [
              "string",
              "null"
            ]
          },
          "sources": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "url": {
                  "type": "string",
                  "pattern": "^(https?:\\/\\/\\S+|user_supplied:[a-z0-9_.-]+)$",
                  "description": "Where the fact came from: an http(s) URL, or `user_supplied:<source_id>` for a user list with no link"
                },
                "title": {
                  "description": "Page or document title, if known",
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "publisher": {
                  "description": "Publisher or site, if known",
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "retrieved_at": {
                  "type": "string",
                  "format": "date",
                  "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$",
                  "description": "Date the source was read"
                },
                "kind": {
                  "type": "string",
                  "enum": [
                    "primary",
                    "secondary",
                    "user_supplied"
                  ],
                  "description": "primary, secondary or user_supplied (PROJECT_CONTEXT §5)"
                }
              },
              "required": [
                "url",
                "title",
                "publisher",
                "retrieved_at",
                "kind"
              ],
              "additionalProperties": false,
              "description": "Provenance for a record or a single fact"
            },
            "description": "At least one source; first is primary"
          },
          "confidence": {
            "type": "string",
            "enum": [
              "high",
              "medium",
              "low"
            ],
            "description": "high: primary source or two independent secondaries agree; medium: one reputable secondary; low: user-supplied list or database page only"
          }
        },
        "required": [
          "id",
          "metric",
          "stage",
          "instrument",
          "geography",
          "period",
          "value",
          "unit",
          "sample_size",
          "publisher",
          "notes",
          "sources",
          "confidence"
        ],
        "additionalProperties": false,
        "description": "A published market figure our raise is compared against"
      }
    }
  },
  "required": [
    "version",
    "generated_at",
    "records"
  ],
  "additionalProperties": false
}
