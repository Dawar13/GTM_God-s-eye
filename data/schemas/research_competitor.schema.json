{
  "$id": "capital-atlas/research_competitor.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "key": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$",
      "description": "Queue key; file is cache/<key>.json"
    },
    "researched_at": {
      "type": "string",
      "format": "date",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$",
      "description": "ISO date, YYYY-MM-DD"
    },
    "identity_check": {
      "type": "string",
      "minLength": 1,
      "description": "How the entity was confirmed: domain + description, and what it is not"
    },
    "pages": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string",
            "pattern": "^https?:\\/\\/\\S+$",
            "description": "Absolute http(s) URL"
          },
          "title": {
            "type": [
              "string",
              "null"
            ]
          },
          "publisher": {
            "type": [
              "string",
              "null"
            ]
          },
          "retrieved_at": {
            "type": "string",
            "format": "date",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$",
            "description": "ISO date, YYYY-MM-DD"
          },
          "kind": {
            "type": "string",
            "enum": [
              "primary",
              "press",
              "database"
            ],
            "description": "primary: the entity's own site, fund announcement, SEC/regulator filing; press: reputable media; database: Crunchbase/Tracxn/PitchBook public pages (hints only)"
          }
        },
        "required": [
          "url",
          "title",
          "publisher",
          "retrieved_at",
          "kind"
        ],
        "additionalProperties": false
      }
    },
    "conflicts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "field": {
            "type": "string"
          },
          "values": {
            "minItems": 2,
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "chosen": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          }
        },
        "required": [
          "field",
          "values",
          "chosen",
          "reason"
        ],
        "additionalProperties": false
      }
    },
    "open_items": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "What could not be found"
    },
    "entity_type": {
      "type": "string",
      "const": "competitor"
    },
    "company": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "website": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^https?:\\/\\/\\S+$",
              "description": "Absolute http(s) URL"
            },
            {
              "type": "null"
            }
          ]
        },
        "description": {
          "description": "Paraphrased, one line",
          "type": [
            "string",
            "null"
          ]
        },
        "hq_country": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 2,
              "maxLength": 2
            },
            {
              "type": "null"
            }
          ]
        },
        "founded_year": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "sector": {
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "ai_infra",
                "ai_apps_agents",
                "industrial_manufacturing",
                "robotics_physical_ai",
                "defense_dual_use",
                "hardware_deeptech",
                "space",
                "climate_energy",
                "mobility_ev",
                "supply_chain_logistics",
                "enterprise_saas",
                "dev_tools",
                "fintech",
                "health_bio",
                "consumer",
                "crypto_web3"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "sector_classified_by": {
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "source",
                "model"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "layer": {
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "design_intent",
                "process_planning",
                "plant_ops",
                "quality_vision",
                "autonomy_tooling",
                "robotics",
                "full_stack_factory"
              ]
            },
            {
              "type": "null"
            }
          ],
          "description": "Only for industrial / robotics / hardware tooling"
        }
      },
      "required": [
        "name",
        "website",
        "description",
        "hq_country",
        "founded_year",
        "sector",
        "sector_classified_by",
        "layer"
      ],
      "additionalProperties": false
    },
    "category": {
      "type": "string",
      "enum": [
        "direct",
        "adjacent",
        "remote"
      ]
    },
    "layer": {
      "type": "string",
      "enum": [
        "design_intent",
        "process_planning",
        "plant_ops",
        "quality_vision",
        "autonomy_tooling",
        "robotics",
        "full_stack_factory"
      ]
    },
    "layer_detail": {
      "type": [
        "string",
        "null"
      ]
    },
    "founders": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "named_customers": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "product_summary": {
      "type": [
        "string",
        "null"
      ]
    },
    "pricing": {
      "type": [
        "string",
        "null"
      ]
    },
    "headcount_est": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "value": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            "pages": {
              "minItems": 1,
              "type": "array",
              "items": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "description": "Indexes into pages"
            },
            "snippet": {
              "type": "string",
              "description": "Supporting text from the page, ≤ 25 words, internal verification only"
            }
          },
          "required": [
            "value",
            "pages",
            "snippet"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "revenue_reported": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "value": {
              "type": "object",
              "properties": {
                "amount": {
                  "type": "number",
                  "minimum": 0,
                  "description": "As reported, in `currency`"
                },
                "currency": {
                  "type": "string",
                  "minLength": 3,
                  "maxLength": 3
                },
                "year": {
                  "type": "integer",
                  "minimum": 1990,
                  "maximum": 2100,
                  "description": "Year the revenue is for"
                }
              },
              "required": [
                "amount",
                "currency",
                "year"
              ],
              "additionalProperties": false
            },
            "pages": {
              "minItems": 1,
              "type": "array",
              "items": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "description": "Indexes into pages"
            },
            "snippet": {
              "type": "string",
              "description": "Supporting text from the page, ≤ 25 words, internal verification only"
            }
          },
          "required": [
            "value",
            "pages",
            "snippet"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ],
      "description": "Only if publicly reported; the pipeline converts to USD at that year's rate"
    },
    "rounds": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "company": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "website": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^https?:\\/\\/\\S+$",
                    "description": "Absolute http(s) URL"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "description": {
                "description": "Paraphrased, one line",
                "type": [
                  "string",
                  "null"
                ]
              },
              "hq_country": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 2,
                    "maxLength": 2
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "founded_year": {
                "anyOf": [
                  {
                    "type": "integer",
                    "minimum": -9007199254740991,
                    "maximum": 9007199254740991
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "sector": {
                "anyOf": [
                  {
                    "type": "string",
                    "enum": [
                      "ai_infra",
                      "ai_apps_agents",
                      "industrial_manufacturing",
                      "robotics_physical_ai",
                      "defense_dual_use",
                      "hardware_deeptech",
                      "space",
                      "climate_energy",
                      "mobility_ev",
                      "supply_chain_logistics",
                      "enterprise_saas",
                      "dev_tools",
                      "fintech",
                      "health_bio",
                      "consumer",
                      "crypto_web3"
                    ]
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "sector_classified_by": {
                "anyOf": [
                  {
                    "type": "string",
                    "enum": [
                      "source",
                      "model"
                    ]
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "layer": {
                "anyOf": [
                  {
                    "type": "string",
                    "enum": [
                      "design_intent",
                      "process_planning",
                      "plant_ops",
                      "quality_vision",
                      "autonomy_tooling",
                      "robotics",
                      "full_stack_factory"
                    ]
                  },
                  {
                    "type": "null"
                  }
                ],
                "description": "Only for industrial / robotics / hardware tooling"
              }
            },
            "required": [
              "name",
              "website",
              "description",
              "hq_country",
              "founded_year",
              "sector",
              "sector_classified_by",
              "layer"
            ],
            "additionalProperties": false
          },
          "stage": {
            "type": "string",
            "enum": [
              "pre_seed",
              "seed",
              "series_a",
              "series_b",
              "series_c_plus",
              "growth",
              "strategic",
              "undisclosed"
            ]
          },
          "stage_raw": {
            "type": [
              "string",
              "null"
            ]
          },
          "date": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^\\d{4}(-Q[1-4]|-(0[1-9]|1[0-2])(-(0[1-9]|[12]\\d|3[01]))?)?$",
                "description": "YYYY, YYYY-Qn, YYYY-MM or YYYY-MM-DD; precision is given alongside"
              },
              {
                "type": "null"
              }
            ]
          },
          "date_precision": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "day",
                  "month",
                  "quarter",
                  "year"
                ]
              },
              {
                "type": "null"
              }
            ]
          },
          "amount_original": {
            "anyOf": [
              {
                "type": "number",
                "minimum": 0
              },
              {
                "type": "null"
              }
            ]
          },
          "currency_original": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 3,
                "maxLength": 3
              },
              {
                "type": "null"
              }
            ]
          },
          "valuation_post_original": {
            "anyOf": [
              {
                "type": "number",
                "minimum": 0
              },
              {
                "type": "null"
              }
            ]
          },
          "leads": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Investor names as the source gives them"
          },
          "participants": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "unspecified": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Named without a role"
          },
          "pages": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          },
          "snippet": {
            "type": "string"
          }
        },
        "required": [
          "company",
          "stage",
          "stage_raw",
          "date",
          "date_precision",
          "amount_original",
          "currency_original",
          "valuation_post_original",
          "leads",
          "participants",
          "unspecified",
          "pages",
          "snippet"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "key",
    "researched_at",
    "identity_check",
    "pages",
    "conflicts",
    "open_items",
    "entity_type",
    "company",
    "category",
    "layer",
    "layer_detail",
    "founders",
    "named_customers",
    "product_summary",
    "pricing",
    "headcount_est",
    "revenue_reported",
    "rounds"
  ],
  "additionalProperties": false
}
