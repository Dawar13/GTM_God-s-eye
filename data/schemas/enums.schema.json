{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "capital-atlas/enums.schema.json",
  "$defs": {
    "Sector": {
      "enum": [
        "ai_infra",
        "ai_apps_agents",
        "industrial_manufacturing",
        "robotics_physical_ai",
        "defense_dual_use",
        "hardware_deeptech",
        "space",
        "climate_energy",
        "mobility_ev",
        "supply_chain_logistics",
        "enterprise_saas",
        "dev_tools",
        "fintech",
        "health_bio",
        "consumer",
        "crypto_web3"
      ]
    },
    "InvestorStage": {
      "enum": [
        "pre_seed",
        "seed",
        "series_a",
        "series_b",
        "series_c_plus",
        "growth"
      ]
    },
    "RoundStage": {
      "enum": [
        "pre_seed",
        "seed",
        "series_a",
        "series_b",
        "series_c_plus",
        "growth",
        "strategic",
        "undisclosed"
