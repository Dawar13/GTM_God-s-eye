{
  "$id": "capital-atlas/merges.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "version": {
      "type": "number",
      "const": 2
    },
    "generated_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
      "description": "When the pipeline wrote the file"
    },
    "records": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^merge_[a-z0-9][a-z0-9_-]*$",
            "description": "Stable id, `merge_<slug>`"
          },
          "investor_id": {
            "type": "string",
            "pattern": "^inv_[a-z0-9][a-z0-9_-]*$",
            "description": "Stable id, `inv_<slug>`"
          },
          "kept_name": {
            "type": "string"
          },
          "merged_name": {
            "type": "string"
          },
          "method": {
            "type": "string",
            "enum": [
              "normalised_name",
              "fuzzy",
              "alias"
            ]
          },
          "score": {
            "anyOf": [
              {
                "type": "number",
                "minimum": 0,
                "maximum": 100
              },
              {
                "type": "null"
              }
            ],
            "description": "rapidfuzz score for fuzzy merges"
          },
          "source_ids": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Lists the merged name came from"
          }
        },
        "required": [
          "id",
          "investor_id",
          "kept_name",
          "merged_name",
          "method",
          "score",
          "source_ids"
        ],
        "additionalProperties": false,
        "description": "Name merge; every one is logged for review"
      }
    }
  },
  "required": [
    "version",
    "generated_at",
    "records"
  ],
  "additionalProperties": false
}
