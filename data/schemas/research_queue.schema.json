{
  "$id": "capital-atlas/research_queue.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "updated_at": {
      "type": "string",
      "format": "date",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$",
      "description": "ISO date, YYYY-MM-DD"
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string"
          },
          "entity_type": {
            "type": "string",
            "enum": [
              "investor",
              "competitor",
              "round",
              "benchmark",
              "legal"
            ]
          },
          "name": {
            "type": "string"
          },
          "investor_id": {
            "description": "Phase 0 id when the entity already existed",
            "type": [
              "string",
              "null"
            ]
          },
          "tier": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "A",
                  "B",
                  "C"
                ]
              },
              {
                "type": "null"
              }
            ]
          },
          "score": {
            "type": [
              "number",
              "null"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "todo",
              "in_progress",
              "done",
              "blocked"
            ]
          },
          "blocked_reason": {
            "type": [
              "string",
              "null"
            ]
          },
          "last_touched": {
            "anyOf": [
              {
                "type": "string",
                "format": "date",
                "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$",
                "description": "ISO date, YYYY-MM-DD"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "key",
          "entity_type",
          "name",
          "investor_id",
          "tier",
          "score",
          "status",
          "blocked_reason",
          "last_touched"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "updated_at",
    "entries"
  ],
  "additionalProperties": false
}
