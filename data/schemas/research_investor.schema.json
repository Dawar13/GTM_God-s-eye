      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$",
      "description": "Queue key; file is cache/<key>.json"
    },
    "researched_at": {
      "type": "string",
      "format": "date",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$",
      "description": "ISO date, YYYY-MM-DD"
    },
    "identity_check": {
      "type": "string",
      "minLength": 1,
      "description": "How the entity was confirmed: domain + description, and what it is not"
    },
    "pages": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string",
            "pattern": "^https?:\\/\\/\\S+$",
            "description": "Absolute http(s) URL"
          },
          "title": {
            "type": [
              "string",
              "null"
            ]
          },
          "publisher": {
            "type": [
              "string",
              "null"
            ]
          },
          "retrieved_at": {
            "type": "string",
            "format": "date",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$",
            "description": "ISO date, YYYY-MM-DD"
          },
          "kind": {
            "type": "string",
            "enum": [
              "primary",
              "press",
              "database"
            ],
            "description": "primary: the entity's own site, fund announcement, SEC/regulator filing; press: reputable media; database: Crunchbase/Tracxn/PitchBook public pages (hints only)"
          }
        },
        "required": [
          "url",
          "title",
          "publisher",
          "retrieved_at",
          "kind"
        ],
        "additionalProperties": false
      }
    },
    "conflicts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "field": {
            "type": "string"
          },
          "values": {
            "minItems": 2,
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "chosen": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          }
        },
        "required": [
          "field",
          "values",
          "chosen",
          "reason"
        ],
        "additionalProperties": false
      }
    },
    "open_items": {
