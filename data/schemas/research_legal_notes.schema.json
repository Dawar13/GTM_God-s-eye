{
  "$id": "capital-atlas/research_legal_notes.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "array",
  "items": {
    "type": "object",
    "properties": {
      "id": {
        "type": "string",
        "pattern": "^legal_[a-z0-9][a-z0-9_-]*$",
        "description": "Stable id, `legal_<slug>`"
      },
      "topic": {
        "type": "string",
        "enum": [
          "india_flip",
          "reverse_flip",
          "fema_pricing",
          "angel_tax",
          "india_convertible_note",
          "isafe",
          "ccps",
          "delaware_requirement"
        ]
      },
      "title": {
        "type": "string",
        "minLength": 1
      },
      "summary": {
        "type": "string",
        "minLength": 1,
        "description": "Paraphrased, ≤ 80 words, facts only"
      },
      "effective_date": {
        "anyOf": [
          {
            "type": "string",
            "pattern": "^\\d{4}(-Q[1-4]|-(0[1-9]|1[0-2])(-(0[1-9]|[12]\\d|3[01]))?)?$",
            "description": "YYYY, YYYY-Qn, YYYY-MM or YYYY-MM-DD; precision is given alongside"
          },
          {
            "type": "null"
          }
        ]
      },
      "jurisdiction": {
        "type": "string",
        "enum": [
          "india",
          "us",
          "us_delaware"
        ]
      },
      "last_verified": {
        "type": "string",
        "format": "date",
        "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$",
        "description": "ISO date, YYYY-MM-DD"
      },
      "disclaimer": {
        "type": "string",
        "const": "Not legal or tax advice — confirm with your CA / counsel."
      },
      "sources": {
        "minItems": 1,
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "url": {
              "type": "string",
              "pattern": "^(https?:\\/\\/\\S+|user_supplied:[a-z0-9_.-]+)$",
              "description": "Where the fact came from: an http(s) URL, or `user_supplied:<source_id>` for a user list with no link"
            },
            "title": {
              "description": "Page or document title, if known",
              "type": [
                "string",
                "null"
              ]
            },
            "publisher": {
              "description": "Publisher or site, if known",
              "type": [
                "string",
                "null"
              ]
            },
            "retrieved_at": {
              "type": "string",
              "format": "date",
              "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$",
              "description": "Date the source was read"
            },
            "kind": {
              "type": "string",
              "enum": [
                "primary",
                "secondary",
                "user_supplied"
              ],
              "description": "primary, secondary or user_supplied (PROJECT_CONTEXT §5)"
            }
          },
          "required": [
            "url",
            "title",
            "publisher",
            "retrieved_at",
            "kind"
          ],
          "additionalProperties": false,
          "description": "Provenance for a record or a single fact"
        },
        "description": "At least one source; first is primary"
      },
      "confidence": {
        "type": "string",
        "enum": [
          "high",
          "medium",
          "low"
        ],
        "description": "high: primary source or two independent secondaries agree; medium: one reputable secondary; low: user-supplied list or database page only"
      }
    },
    "required": [
      "id",
      "topic",
      "title",
      "summary",
      "effective_date",
      "jurisdiction",
      "last_verified",
      "disclaimer",
      "sources",
      "confidence"
    ],
    "additionalProperties": false,
    "description": "A sourced fact about entity structure or Indian investment rules"
  }
}
